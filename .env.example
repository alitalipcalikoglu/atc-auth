# --- Server ---
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=16384

# --- Storage ---
DB_PATH=./data/auth.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
EVENT_RETENTION_DAYS=90
# How long a delivered (sent_at set) outbox row is kept before it is purged. Undelivered rows are
# never purged regardless of age — see "Audit event durability" in README.md.
AUDIT_OUTBOX_RETENTION_DAYS=7

# --- Callers: id:secret[:role[:proxy]], comma separated. Secrets >= 32 chars. Generate: openssl rand -hex 32
# role: read | write | readwrite (default when omitted, same access every key had before this option existed).
# proxy: the only flag; without it, X-Client-IP is ignored and the socket's own address is used instead.
AUTH_API_KEYS=shop-backend:REPLACE_WITH_64_HEX_CHARS:readwrite:proxy
RATE_LIMIT_MAX=600

# --- Access tokens (ES256). Generate the pair with: npm run keygen
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
# During rotation: public key of the previous pair so live tokens stay valid.
JWT_PREVIOUS_PUBLIC_KEY_PATH=
# Appears as `iss`; use the public URL of this service.
JWT_ISSUER=https://auth.example.com
# Appears as `aud`; your application's identifier.
JWT_AUDIENCE=shop
ACCESS_TOKEN_TTL_SEC=900

# --- Sessions & one-time links ---
REFRESH_TOKEN_TTL_DAYS=30
VERIFY_TOKEN_TTL_MIN=1440
RESET_TOKEN_TTL_MIN=60
RESEND_COOLDOWN_SEC=60

# --- Passwords & lockout ---
PASSWORD_MIN_LENGTH=10
# scrypt cost as log2(N); 15 ≈ 100 ms on a modern core. Raising it re-hashes users on next login.
SCRYPT_LOG_N=15
# Failed sign-ins from ONE address for one account before that address is locked (repeat lockouts double, up to a day).
LOGIN_MAX_FAILURES=10
# Failed sign-ins for one account from every address together before the account itself is locked (distributed attacks).
LOGIN_MAX_FAILURES_TOTAL=50
LOGIN_LOCKOUT_MIN=15
# Active sessions per user; the least recently used one is signed out at the next sign-in. 0 = unlimited.
MAX_SESSIONS=10
# Mail the user when a sign-in comes from a device (user agent) not seen before. The first device is never announced.
NEW_DEVICE_EMAIL=true
# Link in the mail that confirms a new email address; defaults to VERIFY_URL_TEMPLATE.
CHANGE_EMAIL_URL_TEMPLATE=
LOGIN_REQUIRES_VERIFIED_EMAIL=false
# A new password may not repeat the current one or the ones before it (this many in total). 0 = off.
PASSWORD_HISTORY=5
# Check new passwords against Have I Been Pwned (k-anonymity: 5 hex chars of the SHA-1 leave). A failed lookup lets the password through.
PASSWORD_BREACH_CHECK=false
PASSWORD_BREACH_URL=https://api.pwnedpasswords.com
PASSWORD_BREACH_TIMEOUT_MS=2000
# --- End-user MFA (TOTP). 32-byte key that seals the secrets: openssl rand -hex 32. Empty = MFA routes answer 503.
MFA_SECRETS_KEY=
MFA_CHALLENGE_TTL_SEC=300

# --- Email via the notify service ---
NOTIFY_URL=https://notify.internal:3001
NOTIFY_API_KEY=REPLACE_WITH_NOTIFY_KEY_FOR_AUTH
NOTIFY_TIMEOUT_MS=5000
APP_NAME=Shop
EMAIL_LOCALE=tr
# Links placed in emails; {token} is replaced. Point them at YOUR frontend, which then calls this API.
VERIFY_URL_TEMPLATE=https://shop.example.com/verify-email?token={token}
RESET_URL_TEMPLATE=https://shop.example.com/reset-password?token={token}

# --- Events (optional): publish events to atc-webhook-out. Both or neither. A publish-role key on webhook-out.
WEBHOOK_OUT_URL=
WEBHOOK_OUT_API_KEY=
WEBHOOK_OUT_TIMEOUT_MS=5000

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-auth:…:write
AUDIT_URL=
AUDIT_API_KEY=
