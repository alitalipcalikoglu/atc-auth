{
  "name": "@atc-web/atc-auth",
  "version": "1.15.0",
  "private": true,
  "description": "Authentication service: users, passwords, JWT access tokens, rotating refresh tokens, email verification and password reset over HTTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/atc-auth.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "keygen": "node scripts/keygen.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@atc-web/atc-service-core": "github:alitalipcalikoglu/atc-service-core#v1.15.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
